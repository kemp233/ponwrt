# PHYLINK and SFP support for the 2.5G SerDes port (MF lan1 / SFP cage)
#
# NOTE: documentation helper only.  The OpenWrt root .config is NOT part of
# the kernel configuration (see LINUX_KCONFIG_LIST in include/target.mk), so
# options listed here never reach the kernel.  The authoritative place for
# kernel options is target/linux/airoha/an7583/config-6.18, which carries:
#
#   CONFIG_PHYLINK=y
#   CONFIG_SFP=y
#   CONFIG_PCS_AIROHA=y
#   CONFIG_PCS_AIROHA_AN7583=y
#
# Kernel 6.18 has no CONFIG_PHYLINK_SFP / CONFIG_SFP_SFF8472 symbols (SFP
# is a standalone tristate that depends on I2C && PHYLINK), so do not
# re-add them here.
#
# CONFIG_PHYLINK=y
# CONFIG_SFP=y
# CONFIG_PCS_AIROHA=y
# CONFIG_PCS_AIROHA_AN7583=y
