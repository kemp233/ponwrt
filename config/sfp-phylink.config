# PHYLINK and SFP support for 2.5G SerDes (EN8811H on lan1)
CONFIG_PHYLINK=y
CONFIG_PHYLINK_SFP=y
CONFIG_SFP=y
CONFIG_SFP_SFF8472=y

# PCS Airoha driver (already in patches-6.18/310-09)
CONFIG_PCS_AIROHA=y
CONFIG_PCS_AIROHA_AN7581=y

# Dependencies
CONFIG_I2C=y
CONFIG_I2C_MUX=y
CONFIG_MDIO=y
CONFIG_FWNODE_PCS=y