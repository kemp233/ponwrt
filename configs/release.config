CONFIG_PACKAGE_kmod-nf-conntrack-bridge=y
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-nft-bridge=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_mount-utils=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_miniupnpd-nftables=y
# CONFIG_PACKAGE_miniupnpd-iptables is not set
CONFIG_PACKAGE_libcap-ng=y
CONFIG_PACKAGE_libuuid=y
CONFIG_PACKAGE_libnftnl=y
CONFIG_PACKAGE_libffi=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-app-advanced-reboot=y
CONFIG_PACKAGE_uhttpd-mod-ucode=y
CONFIG_PACKAGE_mdio-tools=y
CONFIG_PACKAGE_kmod-mdio-netlink=y

# OpenClash. ImmortalWrt's luci feed already ships luci-app-openclash at the
# same version as vernesong/OpenClash upstream, so it is enabled here instead of
# adding a third-party feed: two feeds defining the same package name would
# collide during `feeds install -a`. Its runtime dependencies (bash, curl, ruby,
# unzip, kmod-tun, dnsmasq-full, luci-compat) are pulled in automatically;
# dnsmasq-full is already selected by both target seeds.
CONFIG_PACKAGE_luci-app-openclash=y

# USB print server. p910nd forwards TCP port 9100+ to /dev/usb/lpX without
# spooling, which is the only print stack available in these feeds - CUPS itself
# is not packaged in immortalwrt/packages. usblp carries an AutoProbe entry, so
# the module loads on plug-in.
CONFIG_PACKAGE_kmod-usb-printer=y
CONFIG_PACKAGE_p910nd=y
CONFIG_PACKAGE_luci-app-p910nd=y

# p910nd announces the printer through procd_add_mdns, which registers over
# D-Bus, so the daemon must be the dbus variant rather than avahi-nodbus-daemon.
CONFIG_PACKAGE_avahi-dbus-daemon=y
CONFIG_PACKAGE_avahi-utils=y
