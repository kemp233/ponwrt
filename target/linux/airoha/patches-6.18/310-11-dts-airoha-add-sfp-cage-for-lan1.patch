From: Christian Marangi <ansuelsmth@gmail.com>
Date: Tue, 21 Oct 2026 10:00:00 +0200
Subject: [PATCH] dts: airoha: add SFP cage for lan1 and connect PCS

Add SFP cage node for the JHD 2.5G SFP module at I2C address 0x51
on the an7583-nokia_xg-040g-mf board. This enables phylink SFP
support for the EN8811H PHY on lan1 (gdm3).

Also connect the external airoha PCS (eth_pcs) to gdm3 via pcs-handle
as required by the phylink support patches.

Signed-off-by: Christian Marangi <ansuelsmth@gmail.com>
---
 arch/arm64/boot/dts/airoha/an7583-nokia_xg-040g-mf-common.dtsi | 17 ++++++++++++++++-
 1 file changed, 16 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/airoha/an7583-nokia_xg-040g-mf-common.dtsi b/arch/arm64/boot/dts/airoha/an7583-nokia_xg-040g-mf-common.dtsi
index xxxxxxx..xxxxxxx 100644
--- a/arch/arm64/boot/dts/airoha/an7583-nokia_xg-040g-mf-common.dtsi
+++ b/arch/arm64/boot/dts/airoha/an7583-nokia_xg-040g-mf-common.dtsi
@@ -207,7 +207,17 @@
 		tx-disable-gpios = <&an7583_pinctrl 15 GPIO_ACTIVE_HIGH>;
 
 		/* The 512 bytes after the bosa header contain per-device optical data. */
 		nvmem-cells = <&pon_calibration>;
 		nvmem-cell-names = "calibration";
 	};
 
+	sfp_cage1: sfp-cage@51 {
+		compatible = "sfp-cage";
+		reg = <0x51>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+	};
+
 };
 
 &snfi {
@@ -330,7 +340,8 @@
 	 * external airoha PCS (1fa09000) instead switches the port to the
 	 * external PCS SerDes configuration, and the link never comes up.
 	 */
-	phy-handle = <&en8811>;
+	phy-handle = <&en8811>;
+	pcs-handle = <&eth_pcs>;
 	phy-mode = "2500base-x";
 
 	nvmem-cell-names = "mac-address";
